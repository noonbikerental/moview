{
  "name": "moview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "npx @11ty/eleventy && npx pagefind --site _site",
    "clean": "rm -rf _site .cache",
    "lint": "node --check eleventy.config.js && node --check src/_data/tmdb.js && node --check src/_data/tmdbHome.js && node --check src/_data/supabaseConfig.js && node --check src/assets/main.js && node --check src/assets/community.js && node --check src/assets/search.js && node --check src/assets/title.js && node --check functions/api/search.js && node --check functions/api/title.js && node --check server.js"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-fetch": "^6.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
