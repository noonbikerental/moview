<header class="sticky top-0 z-40 border-b border-white/10 bg-[#0E0F13]/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-8 px-4 py-3.5 sm:px-6">
    {# Zone 1: Single-element brand wordmark #}
    <a
      href="/"
      class="font-display text-xl font-bold tracking-tight text-[#F5F5F5] whitespace-nowrap shrink-0 transition-colors hover:text-white"
    >
      Moview<span class="text-[#E50914]">.</span>
    </a>

    {# Zone 2: Concise single-line navigation links #}
    <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-300">
      <a
        href="/reviews/"
        {% if page.url and page.url.startsWith('/reviews/') %}aria-current="page" class="text-white underline decoration-[#E50914] decoration-2 underline-offset-8 whitespace-nowrap shrink-0"{% else %}class="whitespace-nowrap shrink-0 transition-colors hover:text-white"{% endif %}
      >Reviews</a>
      <a
        href="/movies/"
        {% if page.url and page.url.startsWith('/movies/') %}aria-current="page" class="text-white underline decoration-[#E50914] decoration-2 underline-offset-8 whitespace-nowrap shrink-0"{% else %}class="whitespace-nowrap shrink-0 transition-colors hover:text-white"{% endif %}
      >Movies</a>
      <a
        href="/web-series/"
        {% if page.url and page.url.startsWith('/web-series/') %}aria-current="page" class="text-white underline decoration-[#E50914] decoration-2 underline-offset-8 whitespace-nowrap shrink-0"{% else %}class="whitespace-nowrap shrink-0 transition-colors hover:text-white"{% endif %}
      >Web Series</a>
      <a
        href="/lists/"
        {% if page.url and page.url.startsWith('/lists/') %}aria-current="page" class="text-white underline decoration-[#E50914] decoration-2 underline-offset-8 whitespace-nowrap shrink-0"{% else %}class="whitespace-nowrap shrink-0 transition-colors hover:text-white"{% endif %}
      >Lists</a>
      <a
        href="/about/"
        {% if page.url == '/about/' %}aria-current="page" class="text-white underline decoration-[#E50914] decoration-2 underline-offset-8 whitespace-nowrap shrink-0"{% else %}class="whitespace-nowrap shrink-0 transition-colors hover:text-white"{% endif %}
      >About</a>
    </nav>

    {# Zone 3: Search icon, Sign in button / Authenticated avatar menu & mobile toggle #}
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <button
        type="button"
        data-search-open
        aria-label="Search reviews, movies, and web series"
        title="Search (Press /)"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-white/15 bg-[#181A20] text-zinc-200 transition-colors hover:border-white/35 hover:text-white shrink-0"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <button
        type="button"
        data-auth-signin-trigger
        class="inline-flex items-center justify-center rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white whitespace-nowrap shrink-0 transition-colors hover:bg-[#F40612]"
      >
        Sign in
      </button>

      <div id="header-user-menu-wrap" class="relative hidden">
        <button
          id="header-avatar-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="Account menu"
          class="flex items-center gap-2 rounded-full border border-white/15 bg-[#181A20] p-1 pr-2.5 text-xs font-medium text-zinc-200 transition-colors hover:border-white/35"
        >
          <img
            id="header-avatar-img"
            src=""
            alt=""
            class="hidden h-7 w-7 rounded-full object-cover"
          />
          <span
            id="header-avatar-fallback"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-[#E50914] text-xs font-bold text-white"
          >M</span>
          <span id="header-avatar-name" class="hidden sm:inline max-w-[110px] truncate text-xs text-zinc-100">Account</span>
          <svg class="h-3.5 w-3.5 text-zinc-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <div
          id="header-user-dropdown"
          role="menu"
          class="hidden absolute right-0 mt-2 w-52 overflow-hidden rounded-lg border border-white/15 bg-[#181A20] py-1.5 shadow-xl"
        >
          <a
            id="header-profile-link"
            href="/settings/"
            role="menuitem"
            class="block px-4 py-2 text-sm text-zinc-200 hover:bg-white/5 hover:text-white"
          >
            My Profile
          </a>
          <a
            href="/my-watchlist/"
            role="menuitem"
            class="block px-4 py-2 text-sm text-zinc-200 hover:bg-white/5 hover:text-white"
          >
            My Watchlist
          </a>
          <a
            href="/settings/"
            role="menuitem"
            class="block px-4 py-2 text-sm text-zinc-200 hover:bg-white/5 hover:text-white"
          >
            Profile Settings
          </a>
          <a
            id="header-admin-link"
            href="/admin-moderation/"
            role="menuitem"
            class="hidden px-4 py-2 text-sm text-amber-300 hover:bg-white/5"
          >
            Admin Moderation
          </a>
          <div class="my-1 border-t border-white/10"></div>
          <button
            type="button"
            data-auth-signout
            role="menuitem"
            class="block w-full px-4 py-2 text-left text-sm text-rose-300 hover:bg-white/5"
          >
            Sign out
          </button>
        </div>
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Toggle navigation menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-white/15 bg-[#181A20] text-[#F5F5F5] md:hidden hover:border-white/30"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav-drawer" class="hidden border-t border-white/10 bg-[#181A20] md:hidden">
    <nav aria-label="Mobile navigation" class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-4">
      <a href="/reviews/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">Reviews</a>
      <a href="/movies/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">Movies</a>
      <a href="/web-series/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">Web Series</a>
      <a href="/lists/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">Lists</a>
      <a href="/about/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">About</a>
      <a href="/my-watchlist/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">My Watchlist</a>
      <a href="/contact/" class="rounded-md px-3 py-2.5 text-sm font-medium text-zinc-200 hover:bg-white/5 hover:text-white">Contact</a>
    </nav>
  </div>
</header>
