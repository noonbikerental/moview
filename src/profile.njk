---
layout: layouts/base.njk
title: "Viewer Profile"
seo_title: "Viewer Profile | Moview"
seo_description: "Public viewer profile, ratings, reviews, and watchlist collections on Moview."
permalink: /u/index.html
noindex: true
---

<div id="public-profile-root" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <div id="profile-loading" class="rounded-lg border border-white/10 bg-[#181A20] p-8 text-sm text-zinc-400">
    Loading viewer profile...
  </div>

  <div id="profile-not-found" class="hidden rounded-lg border border-white/10 bg-[#181A20] p-8">
    <h2 class="font-display text-2xl font-bold text-[#F5F5F5]">Profile not found</h2>
    <p class="mt-2 text-sm text-zinc-400">
      We could not find a Moview viewer profile matching that username.
    </p>
    <a href="/" class="mt-5 inline-block rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white">
      Back to Home
    </a>
  </div>

  <div id="profile-content" class="hidden space-y-12">
    <header class="flex flex-col gap-6 rounded-lg border border-white/10 bg-[#181A20] p-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-5">
        <img
          id="profile-avatar-img"
          src=""
          alt=""
          class="hidden h-20 w-20 shrink-0 rounded-full border border-white/15 object-cover"
        />
        <div
          id="profile-avatar-fallback"
          class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full border border-white/15 bg-[#E50914] font-display text-2xl font-bold text-white"
        >
          M
        </div>

        <div>
          <h1 id="profile-display-name" class="font-display text-2xl font-bold text-[#F5F5F5] sm:text-3xl">Viewer Profile</h1>
          <p id="profile-username" class="mt-0.5 text-sm font-medium text-zinc-400"></p>
          <p id="profile-bio" class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-300"></p>
        </div>
      </div>

      <div id="profile-owner-actions" class="hidden shrink-0">
        <a
          href="/settings/"
          class="inline-flex items-center rounded-md border border-white/15 bg-[#0E0F13] px-4 py-2 text-xs font-semibold text-white hover:border-white/35"
        >
          Edit Profile
        </a>
      </div>
    </header>

    {# Summary Counts #}
    <section aria-label="Profile activity counts" class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-lg border border-white/10 bg-[#181A20] p-4">
        <p class="text-xs text-zinc-400">Watched</p>
        <p id="profile-count-watched" class="mt-1 font-display text-2xl font-bold text-[#F5F5F5] tabular-nums">0</p>
      </div>
      <div class="rounded-lg border border-white/10 bg-[#181A20] p-4">
        <p class="text-xs text-zinc-400">Want to Watch</p>
        <p id="profile-count-want" class="mt-1 font-display text-2xl font-bold text-[#F5F5F5] tabular-nums">0</p>
      </div>
      <div class="rounded-lg border border-white/10 bg-[#181A20] p-4">
        <p class="text-xs text-zinc-400">Maybe Later</p>
        <p id="profile-count-maybe" class="mt-1 font-display text-2xl font-bold text-[#F5F5F5] tabular-nums">0</p>
      </div>
      <div class="rounded-lg border border-white/10 bg-[#181A20] p-4">
        <p class="text-xs text-zinc-400">Reviews</p>
        <p id="profile-count-reviews" class="mt-1 font-display text-2xl font-bold text-[#E50914] tabular-nums">0</p>
      </div>
    </section>

    {# User's Reviews #}
    <section aria-labelledby="profile-reviews-heading">
      <h2 id="profile-reviews-heading" class="font-display text-xl font-bold text-[#F5F5F5]">
        Viewer Reviews
      </h2>
      <div id="profile-reviews-list" class="mt-5 space-y-4"></div>
    </section>

    {# Three Watchlist Poster Grids #}
    <section aria-labelledby="profile-watched-heading">
      <h2 id="profile-watched-heading" class="font-display text-xl font-bold text-[#F5F5F5]">
        &#9989; Watched
      </h2>
      <div id="profile-grid-watched" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5"></div>
    </section>

    <section aria-labelledby="profile-want-heading">
      <h2 id="profile-want-heading" class="font-display text-xl font-bold text-[#F5F5F5]">
        &#128204; Want to Watch
      </h2>
      <div id="profile-grid-want" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5"></div>
    </section>

    <section aria-labelledby="profile-maybe-heading">
      <h2 id="profile-maybe-heading" class="font-display text-xl font-bold text-[#F5F5F5]">
        &#129300; Maybe Later
      </h2>
      <div id="profile-grid-maybe" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5"></div>
    </section>
  </div>
</div>
