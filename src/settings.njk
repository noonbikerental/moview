---
layout: layouts/base.njk
title: "Profile Settings"
seo_title: "Profile Settings | Moview"
seo_description: "Update your Moview username, display name, bio, or delete your account."
permalink: /settings/index.html
noindex: true
---

<div id="profile-settings-root" class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:py-14">
  <header class="border-b border-white/10 pb-6">
    <h1 class="font-display text-3xl font-bold tracking-tight text-[#F5F5F5]">
      Profile Settings
    </h1>
    <p class="mt-2 text-sm text-zinc-400">
      Manage your public handle, bio, and account data.
    </p>
  </header>

  <div id="settings-signed-out" class="mt-8 hidden rounded-lg border border-white/10 bg-[#181A20] p-8">
    <p class="text-sm text-zinc-300">Please sign in to edit your profile settings.</p>
    <button
      type="button"
      data-auth-signin-trigger
      class="mt-4 rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white hover:bg-[#F40612]"
    >
      Sign in
    </button>
  </div>

  <div id="settings-signed-in" class="mt-8 hidden space-y-10">
    <form id="profile-settings-form" class="space-y-5 rounded-lg border border-white/10 bg-[#181A20] p-6">
      <div>
        <label for="settings-username" class="block text-xs font-medium text-zinc-300">
          Username (3–20 chars: letters, numbers, underscores)
        </label>
        <input
          id="settings-username"
          name="username"
          type="text"
          required
          minlength="3"
          maxlength="20"
          pattern="[A-Za-z0-9_]{3,20}"
          class="mt-1.5 w-full rounded-md border border-white/15 bg-[#0E0F13] px-3.5 py-2.5 text-sm text-white focus:border-[#E50914] focus:outline-none"
        />
      </div>

      <div>
        <label for="settings-display-name" class="block text-xs font-medium text-zinc-300">
          Display Name (max 60 chars)
        </label>
        <input
          id="settings-display-name"
          name="display_name"
          type="text"
          maxlength="60"
          class="mt-1.5 w-full rounded-md border border-white/15 bg-[#0E0F13] px-3.5 py-2.5 text-sm text-white focus:border-[#E50914] focus:outline-none"
        />
      </div>

      <div>
        <div class="flex items-center justify-between">
          <label for="settings-bio" class="block text-xs font-medium text-zinc-300">
            Bio (optional, max 160 chars)
          </label>
          <span id="settings-bio-count" class="text-xs text-zinc-500 tabular-nums">0 / 160</span>
        </div>
        <textarea
          id="settings-bio"
          name="bio"
          rows="3"
          maxlength="160"
          placeholder="Tell other viewers what genres or shows you love..."
          class="mt-1.5 w-full rounded-md border border-white/15 bg-[#0E0F13] px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-[#E50914] focus:outline-none"
        ></textarea>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <a id="settings-public-profile-link" href="/u/" class="text-xs text-zinc-400 underline underline-offset-4 hover:text-white">
          View public profile
        </a>
        <button
          type="submit"
          class="rounded-md bg-[#E50914] px-5 py-2.5 text-xs font-semibold text-white hover:bg-[#F40612]"
        >
          Save Changes
        </button>
      </div>

      <p id="settings-save-status" class="text-xs text-zinc-400" aria-live="polite"></p>
    </form>

    {# Danger Zone: Delete My Account #}
    <section class="rounded-lg border border-rose-500/35 bg-rose-500/5 p-6">
      <h2 class="font-display text-lg font-semibold text-rose-200">Delete my account</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-zinc-300">
        This permanently deletes your Moview login, profile, viewer reviews, helpful votes, reports, and watchlist items. This action cannot be undone.
      </p>

      <form id="delete-account-form" class="mt-4 space-y-3">
        <div>
          <label for="delete-confirm-input" class="block text-xs font-medium text-zinc-300">
            Type <strong>DELETE</strong> to confirm permanent removal
          </label>
          <input
            id="delete-confirm-input"
            type="text"
            required
            autocomplete="off"
            placeholder="DELETE"
            class="mt-1.5 w-full max-w-xs rounded-md border border-rose-500/35 bg-[#0E0F13] px-3.5 py-2 text-sm text-white placeholder-zinc-500 focus:border-rose-400 focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="rounded-md bg-rose-600 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-rose-500"
        >
          Delete my account
        </button>
        <p id="delete-account-status" class="text-xs text-zinc-400" aria-live="polite"></p>
      </form>
    </section>
  </div>
</div>
