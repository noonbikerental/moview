---
layout: layouts/base.njk
title: "Title Details"
seo_title: "Title Details & Viewer Reviews | Moview"
seo_description: "Check streaming availability in India, trailer, cast, and viewer reviews on Moview."
permalink: /title/index.html
noindex: true
---

<div id="title-page-root">
  {# Loading State #}
  <div id="title-loading" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="animate-pulse grid gap-8 md:grid-cols-[220px_1fr]">
      <div class="aspect-[2/3] w-44 sm:w-52 md:w-full rounded-lg bg-[#181A20]"></div>
      <div class="space-y-4 py-2">
        <div class="h-4 w-40 rounded bg-[#181A20]"></div>
        <div class="h-10 w-3/4 rounded bg-[#181A20]"></div>
        <div class="h-20 w-full max-w-2xl rounded bg-[#181A20]"></div>
      </div>
    </div>
  </div>

  {# Error / Unconfigured State #}
  <div id="title-error" class="hidden mx-auto max-w-3xl px-4 py-16 sm:px-6 text-center">
    <div class="rounded-lg border border-white/10 bg-[#181A20] p-8">
      <h1 id="title-error-heading" class="font-display text-2xl font-bold text-[#F5F5F5]">
        Could not load this title
      </h1>
      <p id="title-error-message" class="mt-3 text-sm leading-relaxed text-zinc-400">
        Please verify the title link or try searching again.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/search/" class="rounded-md bg-[#E50914] px-5 py-2.5 text-xs font-semibold text-white hover:bg-[#F40612]">
          Search Titles
        </a>
        <a href="/" class="rounded-md border border-white/15 bg-[#0E0F13] px-5 py-2.5 text-xs font-medium text-zinc-200 hover:border-white/35 hover:text-white">
          Back Home
        </a>
      </div>
    </div>
  </div>

  {# Hydrated Title View #}
  <article id="title-content" class="hidden">
    <section class="relative overflow-hidden border-b border-white/10 bg-[#13151B]">
      <img
        id="title-backdrop"
        src=""
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="hidden absolute inset-0 h-full w-full object-cover opacity-35"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0E0F13] via-[#0E0F13]/85 to-[#0E0F13]/70"></div>

      <div class="relative mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-12">
        <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs text-zinc-400">
          <a href="/" class="hover:text-white">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/search/" class="hover:text-white">Search</a>
          <span aria-hidden="true">/</span>
          <span id="title-breadcrumb-name" class="text-zinc-200">Title</span>
        </nav>

        {# Editorial Review Banner (shown if Moview already reviewed this title) #}
        <div id="title-reviewed-banner" class="hidden mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-emerald-500/35 bg-emerald-500/10 px-4 py-3 text-sm">
          <p class="text-emerald-100">
            Moview has published an editorial review for this title (<span id="title-reviewed-meta" class="font-semibold"></span>).
          </p>
          <a id="title-reviewed-link" href="/reviews/" class="rounded-md bg-[#E50914] px-4 py-1.5 text-xs font-semibold text-white hover:bg-[#F40612] whitespace-nowrap">
            Read Full Review &rarr;
          </a>
        </div>

        <div class="grid gap-8 md:grid-cols-[220px_1fr] lg:grid-cols-[250px_1fr] md:items-end">
          <div class="w-44 sm:w-52 md:w-full shrink-0 overflow-hidden rounded-lg border border-white/15 bg-[#181A20]">
            <img
              id="title-poster"
              src=""
              alt=""
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class="hidden aspect-[2/3] w-full object-cover"
            />
            <div id="title-poster-fallback" class="poster-fallback flex aspect-[2/3] w-full flex-col justify-between p-4">
              <span id="title-poster-type" class="text-xs font-medium text-zinc-400">Movie</span>
              <div>
                <p id="title-poster-title" class="font-display text-xl font-bold text-white"></p>
                <p id="title-poster-year" class="mt-1 text-xs text-zinc-400 tabular-nums"></p>
              </div>
            </div>
          </div>

          <div>
            <div id="title-meta-row" class="flex flex-wrap items-center gap-2 text-xs font-medium text-zinc-300 tabular-nums"></div>

            <h1 id="title-heading" class="mt-2 font-display text-3xl font-bold tracking-tight text-[#F5F5F5] sm:text-4xl lg:text-5xl">
              Title
            </h1>

            <p id="title-tagline" class="hidden mt-2 text-base italic text-zinc-300"></p>
            <p id="title-overview-hero" class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-200"></p>

            {# Watchlist Status Picker + Request a Review Action #}
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <div
                id="title-watchlist-picker"
                class="flex flex-wrap items-center gap-2"
                data-watchlist-picker
                data-tmdb-id=""
                data-media-type=""
                data-title=""
                data-poster-path=""
              >
                <span class="text-xs font-medium text-zinc-400 mr-1">My List:</span>
                <button
                  type="button"
                  data-watchlist-status="watched"
                  aria-pressed="false"
                  class="rounded-md border border-white/15 bg-[#181A20] px-3 py-1.5 text-xs font-medium text-zinc-200 transition-colors hover:border-white/35 hover:text-white whitespace-nowrap"
                >
                  &#9989; Watched
                </button>
                <button
                  type="button"
                  data-watchlist-status="want_to_watch"
                  aria-pressed="false"
                  class="rounded-md border border-white/15 bg-[#181A20] px-3 py-1.5 text-xs font-medium text-zinc-200 transition-colors hover:border-white/35 hover:text-white whitespace-nowrap"
                >
                  &#128204; Want to Watch
                </button>
                <button
                  type="button"
                  data-watchlist-status="maybe_later"
                  aria-pressed="false"
                  class="rounded-md border border-white/15 bg-[#181A20] px-3 py-1.5 text-xs font-medium text-zinc-200 transition-colors hover:border-white/35 hover:text-white whitespace-nowrap"
                >
                  &#129300; Maybe Later
                </button>
              </div>

              <div id="request-review-wrap" class="flex flex-wrap items-center gap-2.5">
                <button
                  id="request-review-btn"
                  type="button"
                  class="rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#F40612] whitespace-nowrap"
                >
                  Request a review
                </button>
                <span id="request-review-status" class="text-xs text-zinc-400" aria-live="polite"></span>
              </div>
            </div>

            <dl id="title-credits-dl" class="mt-6 grid gap-3 border-t border-white/10 pt-5 text-sm sm:grid-cols-2 lg:grid-cols-3"></dl>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
      <div class="grid gap-10 lg:grid-cols-[1fr_320px] lg:items-start">
        <div class="min-w-0">
          {# Trailer Section #}
          <section id="title-trailer-section" class="hidden" aria-labelledby="title-trailer-heading">
            <h2 id="title-trailer-heading" class="font-display text-2xl font-semibold text-[#F5F5F5]">
              Official Trailer
            </h2>
            <div
              id="title-youtube-lite"
              class="relative mt-4 aspect-video w-full overflow-hidden rounded-lg border border-white/10 bg-[#181A20]"
            >
              <img
                id="title-trailer-thumb"
                src=""
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
              <div class="absolute inset-0 bg-black/35"></div>
              <button
                id="title-trailer-play"
                type="button"
                aria-label="Play official trailer"
                class="absolute inset-0 flex items-center justify-center group"
              >
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[#E50914] text-white shadow-lg transition-transform duration-200 group-hover:scale-105 group-hover:bg-[#F40612]">
                  <svg class="ml-1 h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </button>
            </div>
          </section>

          {# Top 8 Cast Section #}
          <section id="title-cast-section" class="hidden mt-12 border-t border-white/10 pt-10" aria-labelledby="title-cast-heading">
            <h2 id="title-cast-heading" class="font-display text-2xl font-semibold text-[#F5F5F5]">
              Cast
            </h2>
            <div id="title-cast-grid" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4"></div>
          </section>

          {# Shared Community Viewer Reviews Section #}
          <section
            id="viewer-reviews"
            class="mt-12 border-t border-white/10 pt-10"
            aria-labelledby="viewer-reviews-heading"
            data-tmdb-id=""
            data-media-type=""
            data-title=""
            data-poster-path=""
          >
            <div class="flex flex-wrap items-baseline justify-between gap-4">
              <div>
                <h2 id="viewer-reviews-heading" class="font-display text-2xl font-semibold text-[#F5F5F5]">
                  Viewer Reviews
                </h2>
                <p class="mt-1 text-xs text-zinc-400">
                  Community ratings out of 5 stars from Moview readers.
                </p>
              </div>
            </div>

            <div class="mt-6 grid gap-6 rounded-lg border border-white/10 bg-[#181A20] p-5 sm:grid-cols-[190px_1fr] sm:items-center">
              <div class="text-left sm:border-r sm:border-white/10 sm:pr-6">
                <p class="text-xs font-medium text-zinc-400">Viewer Rating</p>
                <div class="mt-1 flex items-baseline gap-2 tabular-nums">
                  <span id="viewer-avg-score" class="font-display text-3xl font-bold text-[#F5F5F5]">--</span>
                  <span class="text-sm text-zinc-400">/ 5</span>
                </div>
                <div id="viewer-avg-stars" class="mt-1.5 flex items-center gap-1 text-amber-400" aria-hidden="true"></div>
                <p id="viewer-total-count" class="mt-1.5 text-xs text-zinc-400 tabular-nums">Loading viewer ratings...</p>
              </div>

              <div id="viewer-star-breakdown" class="space-y-1.5">
                {% for star in [5, 4, 3, 2, 1] %}
                  <div class="flex items-center gap-3 text-xs tabular-nums">
                    <span class="w-10 text-zinc-300">{{ star }} &#9733;</span>
                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-[#0E0F13]">
                      <div
                        data-breakdown-bar="{{ star }}"
                        class="h-full rounded-full bg-[#E50914] transition-all duration-300"
                        style="width: 0%"
                      ></div>
                    </div>
                    <span data-breakdown-count="{{ star }}" class="w-8 text-right text-zinc-400">0</span>
                  </div>
                {% endfor %}
              </div>
            </div>

            <div id="rate-review-box" class="mt-6 rounded-lg border border-white/10 bg-[#181A20] p-5">
              <div id="rate-signed-out" class="flex flex-wrap items-center justify-between gap-4">
                <div>
                  <h3 class="font-display text-base font-semibold text-[#F5F5F5]">Rate &amp; Review this title</h3>
                  <p class="mt-1 text-sm text-zinc-400">Share your 5-star rating and thoughts with fellow viewers.</p>
                </div>
                <button
                  type="button"
                  data-auth-signin-trigger
                  class="rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#F40612] whitespace-nowrap"
                >
                  Sign in to rate
                </button>
              </div>

              <form id="viewer-review-form" class="hidden space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 id="viewer-form-heading" class="font-display text-base font-semibold text-[#F5F5F5]">
                    Your Rating &amp; Review
                  </h3>
                  <a href="/community-guidelines/" class="text-xs text-zinc-400 underline underline-offset-4 hover:text-white">
                    Community Guidelines
                  </a>
                </div>

                <div>
                  <span class="block text-xs font-medium text-zinc-300">Your Rating</span>
                  <div id="star-rating-input" class="mt-1.5 flex items-center gap-1.5" role="radiogroup" aria-label="Rate from 1 to 5 stars">
                    {% for n in [1, 2, 3, 4, 5] %}
                      <button
                        type="button"
                        data-star-value="{{ n }}"
                        aria-label="{{ n }} {{ 'star' if n == 1 else 'stars' }}"
                        aria-pressed="false"
                        class="rounded p-1 text-2xl leading-none text-zinc-600 transition-colors hover:text-amber-400"
                      >
                        &#9733;
                      </button>
                    {% endfor %}
                    <span id="star-rating-label" class="ml-2 text-xs text-zinc-400 tabular-nums">Select a rating</span>
                  </div>
                </div>

                <div>
                  <div class="flex items-center justify-between">
                    <label for="viewer-review-text" class="block text-xs font-medium text-zinc-300">
                      Review (optional)
                    </label>
                    <span id="viewer-review-charcount" class="text-xs text-zinc-400 tabular-nums">0 / 2000</span>
                  </div>
                  <textarea
                    id="viewer-review-text"
                    name="review_text"
                    rows="4"
                    maxlength="2000"
                    placeholder="What stood out—performances, pacing, music, or the ending?"
                    class="mt-1.5 w-full rounded-md border border-white/15 bg-[#0E0F13] px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-[#E50914] focus:outline-none"
                  ></textarea>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-4">
                  <label class="inline-flex items-center gap-2 text-xs text-zinc-300 cursor-pointer">
                    <input
                      id="viewer-review-spoilers"
                      name="has_spoilers"
                      type="checkbox"
                      class="h-4 w-4 rounded border-white/25 bg-[#0E0F13] text-[#E50914] focus:ring-[#E50914]"
                    />
                    <span>Contains spoilers</span>
                  </label>

                  <div class="flex flex-wrap items-center gap-2.5">
                    <button
                      id="viewer-review-delete-btn"
                      type="button"
                      class="hidden rounded-md border border-rose-500/40 px-3.5 py-2 text-xs font-medium text-rose-300 hover:bg-rose-500/10"
                    >
                      Delete Review
                    </button>
                    <button
                      id="viewer-review-submit-btn"
                      type="submit"
                      class="rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#F40612]"
                    >
                      Post Review
                    </button>
                  </div>
                </div>

                <p id="viewer-review-status" class="text-xs text-zinc-400" aria-live="polite"></p>
              </form>
            </div>

            <div class="mt-8">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3">
                <h3 class="font-display text-base font-semibold text-[#F5F5F5]">Community Feed</h3>
                <div class="flex items-center gap-1 rounded-md border border-white/10 bg-[#181A20] p-1">
                  <button
                    type="button"
                    data-review-sort="helpful"
                    aria-pressed="true"
                    class="rounded px-3 py-1 text-xs font-semibold bg-[#E50914] text-white whitespace-nowrap"
                  >
                    Most Helpful
                  </button>
                  <button
                    type="button"
                    data-review-sort="newest"
                    aria-pressed="false"
                    class="rounded px-3 py-1 text-xs font-medium text-zinc-300 hover:text-white whitespace-nowrap"
                  >
                    Newest
                  </button>
                </div>
              </div>

              <div id="viewer-reviews-list" class="mt-4 space-y-4">
                <p class="text-sm text-zinc-400">Loading community reviews...</p>
              </div>

              <div id="viewer-reviews-load-more-wrap" class="mt-6 hidden text-center">
                <button
                  id="viewer-reviews-load-more"
                  type="button"
                  class="rounded-md border border-white/15 bg-[#181A20] px-5 py-2.5 text-xs font-semibold text-zinc-200 transition-colors hover:border-white/35 hover:text-white"
                >
                  Load 10 more reviews
                </button>
              </div>
            </div>
          </section>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-24">
          <section class="rounded-lg border border-white/10 bg-[#181A20] p-5">
            <h2 class="font-display text-lg font-semibold text-[#F5F5F5]">
              Where to watch in India
            </h2>
            <div id="title-providers-body" class="mt-3"></div>
            <p class="mt-4 border-t border-white/10 pt-3 text-xs text-zinc-400">
              {{ site.justwatchAttribution }}
            </p>
          </section>
        </aside>
      </div>
    </div>
  </article>
</div>

<script defer src="/assets/title.js"></script>
