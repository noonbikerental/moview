---
layout: layouts/base.njk
title: "Sign In"
seo_title: "Sign In | Moview"
seo_description: "Sign in to Moview with Google or an email magic link to rate films, write reviews, and manage your watchlist."
permalink: /sign-in/index.html
noindex: true
---

<div class="mx-auto max-w-md px-4 py-14 sm:px-6 lg:py-20">
  <div class="rounded-lg border border-white/15 bg-[#181A20] p-6 sm:p-8">
    <h1 class="font-display text-2xl font-bold tracking-tight text-[#F5F5F5]">
      Sign in to Moview
    </h1>
    <p class="mt-2 text-sm leading-relaxed text-zinc-400">
      Join the community to rate movies and web series, share reviews, and save titles to your personal watchlist.
    </p>

    <div id="signin-page-signed-in" class="mt-6 hidden rounded-md border border-white/10 bg-[#0E0F13] p-4">
      <p class="text-sm text-zinc-200">
        You are currently signed in<span id="signin-page-handle"></span>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/my-watchlist/"
          class="rounded-md bg-[#E50914] px-4 py-2 text-xs font-semibold text-white hover:bg-[#F40612]"
        >
          Go to My Watchlist
        </a>
        <a
          href="/settings/"
          class="rounded-md border border-white/15 px-4 py-2 text-xs font-medium text-zinc-200 hover:border-white/35"
        >
          Profile Settings
        </a>
      </div>
    </div>

    <div id="signin-page-forms" class="mt-6 space-y-5">
      <button
        type="button"
        data-google-signin
        class="flex w-full items-center justify-center gap-2.5 rounded-md border border-white/20 bg-[#0E0F13] px-4 py-2.5 text-sm font-medium text-white transition-colors hover:border-white/40 hover:bg-[#14161D]"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.2-1.4 3.6-5.5 3.6-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.2.8 3.9 1.5l2.7-2.6C16.9 3 14.7 2 12 2 6.5 2 2 6.5 2 12s4.5 10 10 10c5.8 0 9.6-4.1 9.6-9.8 0-.7-.1-1.2-.2-1.8H12z"/>
        </svg>
        Continue with Google
      </button>

      <div class="relative flex items-center">
        <div class="flex-grow border-t border-white/10"></div>
        <span class="mx-3 text-xs text-zinc-400">or email magic link</span>
        <div class="flex-grow border-t border-white/10"></div>
      </div>

      <form data-magic-link-form class="space-y-3">
        <div>
          <label for="page-magic-email" class="block text-xs font-medium text-zinc-300">Email address</label>
          <input
            id="page-magic-email"
            name="email"
            type="email"
            required
            placeholder="you@example.com"
            class="mt-1.5 w-full rounded-md border border-white/15 bg-[#0E0F13] px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-[#E50914] focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-md bg-[#E50914] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#F40612]"
        >
          Send Magic Link
        </button>
        <p data-magic-link-status class="text-xs text-zinc-400" aria-live="polite"></p>
      </form>

      <p class="text-xs leading-relaxed text-zinc-400">
        By signing in, you agree to our <a href="/community-guidelines/" class="underline underline-offset-4 hover:text-zinc-300">Community Guidelines</a> and <a href="/privacy-policy/" class="underline underline-offset-4 hover:text-zinc-300">Privacy Policy</a>.
      </p>
    </div>
  </div>
</div>
